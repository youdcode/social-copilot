{
  "name": "social-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "Watches tech news (X API read-only, RSS, Hacker News), drafts posts for X, Threads, Bluesky, LinkedIn, Instagram, TikTok and YouTube Shorts with Mistral, and proposes them in a private Telegram bot. Never publishes anything.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file=.env src/cli/start.ts",
    "dry-run": "node --env-file=.env src/cli/dry-run.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "db:migrate": "node src/cli/migrate.ts",
    "x:resolve": "node --env-file=.env src/cli/x-resolve.ts",
    "x:purge": "node src/cli/x-purge.ts",
    "telegram:chat-id": "node --env-file=.env src/cli/telegram-chat-id.ts",
    "mac:install": "node src/cli/launchd.ts install",
    "mac:uninstall": "node src/cli/launchd.ts uninstall",
    "mac:status": "node src/cli/launchd.ts status"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@grammyjs/auto-retry": "2.0.2",
    "@mistralai/mistralai": "2.7.0",
    "@resvg/resvg-js": "2.6.2",
    "better-sqlite3": "13.0.3",
    "fast-xml-parser": "5.11.1",
    "grammy": "1.46.0",
    "gsap": "3.15.1",
    "hyperframes": "0.9.30",
    "kokoro-js": "1.2.1",
    "node-cron": "4.6.0",
    "satori": "0.63.2",
    "twitter-text": "3.1.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "@types/twitter-text": "3.1.10",
    "typescript": "7.0.2"
  },
  "overrides": {
    "fflate": "0.8.3",
    "undici": "7.30.2"
  }
}
