# Variables lues par le service. Ajoute-les à .env, qui ne doit jamais être commité.

# Mistral : clé dédiée à ce projet.
MISTRAL_API_KEY=

# Telegram : jeton donné par BotFather, et identifiant du seul chat autorisé.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# X : jeton d'application (Bearer), pour lire les comptes suivis.
X_BEARER_TOKEN=

# X : client OAuth 2.0 de l'application, pour lire les mentions du compte
# (scopes tweet.read, users.read et offline.access uniquement). Utilisé à l'étape 5.
X_CLIENT_ID=
X_CLIENT_SECRET=
