# Variables lues par le service. Ajoute-les à .env, qui ne doit jamais être commité.

# Mistral : clé dédiée à ce projet.
MISTRAL_API_KEY=

# Telegram : jeton donné par BotFather, et identifiant du seul chat autorisé.
# Pour trouver l'identifiant : npm run telegram:chat-id, puis écris au bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# X : jeton d'application (Bearer), pour lire les comptes suivis.
X_BEARER_TOKEN=

# X : jetons OAuth 1.0a du compte propriétaire de l'app, pour lire ses mentions.
# L'app doit être réglée en « Read only » AVANT de générer l'Access Token : il ne peut alors rien écrire.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
