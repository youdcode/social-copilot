# Variables read by the service. Put them in .env, which must never be committed.

# Mistral: a key for this project only.
MISTRAL_API_KEY=

# Telegram: the token BotFather gives, and the id of the only chat allowed.
# To find the id: npm run telegram:chat-id, then write to the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# X: app token (Bearer), to read the watched accounts.
X_BEARER_TOKEN=

# X: OAuth 1.0a tokens of the account that owns the app, to read its mentions ("Replies received").
# Optional: leave all four empty to go without. Partly filled in, the service refuses to start.
# Set the app to "Read only" BEFORE generating the Access Token: it then cannot write anything.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
